# =====================================================================
# MiniAgentLite - File Konfigurasi Lingkungan (.env)
# =====================================================================

# 1. Konfigurasi Telegram Bot
# Dapatkan token bot dengan membuat bot baru di Telegram lewat @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# ID Akun Telegram Anda (PENTING UNTUK KEAMANAN PC ANDA!)
# Agen HANYA akan merespons chat ID ini agar orang lain tidak bisa mengontrol PC Anda.
# Pisahkan dengan koma jika ada lebih dari 1 ID, contoh: 123456789,987654321
# Tips: Ketik /id ke bot @userinfobot di Telegram untuk tahu ID akun Anda.
ALLOWED_USER_IDS=123456789

# 2. Pilihan Mesin AI (LLM Provider)
# Pilih salah satu: "gemini" atau "groq"
LLM_PROVIDER=gemini

# 3. Kredensial Gemini (Jika LLM_PROVIDER=gemini)
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Pilihan Model: gemini-2.5-flash-lite (Super cepat), gemini-1.5-flash-8b, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# 4. Kredensial Groq (Jika LLM_PROVIDER=groq)
# Dapatkan gratis di https://console.groq.com/keys
GROQ_API_KEY=gsk_YourGroqApiKeyHere
# Pilihan Model: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Konfigurasi Keamanan Eksekusi
# Izinkan eksekusi perintah terminal shell (True/False)
ENABLE_TERMINAL_COMMANDS=True
# Izinkan screenshot layar (True/False)
ENABLE_SCREENSHOT=True
